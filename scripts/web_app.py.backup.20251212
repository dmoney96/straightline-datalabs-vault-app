def _deny(reason: str):
    """Raise a runtime error with consistent formatting."""
    raise RuntimeError(f"Security check failed: {reason}")


def _is_private_ip(ip: str) -> bool:
    """Return True if IP is private, loopback, link-local, multicast, etc."""
    try:
        addr = ipaddress.ip_address(ip)
        return (
            addr.is_private
            or addr.is_loopback
            or addr.is_link_local
            or addr.is_reserved
            or addr.is_multicast
            or addr in (
                ipaddress.ip_address("169.254.169.254"),  # AWS metadata
            )
        )
    except Exception:
        # If parsing fails, be paranoid and treat as private
        return True


def _log_debug(msg: str) -> None:
    """Simple stderr logger so messages show up in journalctl."""
    print(f"WEBDEBUG: {msg}", file=sys.stderr, flush=True)


def _guard_remote_url(url: str) -> None:
    """
    Basic SSRF guard: allow only http(s) URLs that resolve to public IPs.

    - Block: loopback, private, link-local, multicast, reserved ranges.
    - Allow: normal public IPv4/IPv6 addresses (Axios, WaPo, etc.).
    """
    parsed = urlparse(url)

    # Only http/https
    if parsed.scheme not in ("http", "https"):
        raise ValueError(f"unsupported scheme: {parsed.scheme!r}")

    host = parsed.hostname
    if not host:
        raise ValueError("URL missing hostname")

    # Resolve host → IPs
    try:
        infos = socket.getaddrinfo(host, None)
    except Exception as e:
        _log_debug(f"_guard_remote_url: DNS failure for {host!r}: {e!r}")
        raise ValueError("dns failure") from e

    resolved_ips = sorted({info[4][0] for info in infos})
    _log_debug(f"_guard_remote_url: {url!r} resolves to {resolved_ips}")

    # Block only non-public ranges
    for ip_str in resolved_ips:
        try:
            ip = ipaddress.ip_address(ip_str)
        except Exception as e:
            _log_debug(f"_guard_remote_url: unparsable ip {ip_str!r}: {e!r}")
            raise ValueError("bad ip") from e

        if (
            ip.is_loopback
            or ip.is_private
            or ip.is_link_local
            or ip.is_multicast
            or ip.is_reserved
        ):
            _log_debug(f"_guard_remote_url: blocked non-public IP {ip_str}")
            raise ValueError("non-public ip blocked")

    # If we get here, URL is allowed
    return None


# -- Access control decorator --------------------------------------
def require_access(view):
    """
    Temporarily disabled: UI is already protected by HTTP auth / network layer.
    Token checking is only needed for future API-style endpoints.
    """
    @wraps(view)
    def wrapped(*args, **kwargs):
        return view(*args, **kwargs)

    return wrapped


# Fallback OCR directory (manifest doesn't define OCR_DIR constant)
OCR_DIR = DATA_DIR / "ocr"


def index_txt_document(txt_path: str | Path) -> None:
    """Index a TXT document in the Whoosh backend."""
    update_index_for_file(Path(txt_path))


def _slug_from_url(url: str) -> str:
    """Turn a URL into a filesystem-safe slug for TXT filenames."""
    parsed = urlparse(url)
    base = (parsed.netloc + parsed.path).lower()
    slug = re.sub(r"[^a-z0-9]+", "_", base).strip("_")
    return slug or "web_doc"


def ingest_source(url: str, case: str | None = None):
    """
    Download a PDF from `url`, store it under DATA_DIR, convert to TXT,
    append a manifest entry, and index the TXT.

    Returns:
        (pdf_path: Path | None, txt_path: Path | None)
    """
    _log_debug(f"ingest_source: START url={url!r}, case={case!r}")
    # SSRF guard: block internal/metadata URLs before any network call
    _guard_remote_url(url)

    # Where we keep web PDFs
    pdf_root = DATA_DIR / "web_pdfs"
    pdf_root.mkdir(parents=True, exist_ok=True)

    # Reuse URL slug logic so PDF/TXT share a base name
    slug = _slug_from_url(url)
    pdf_path = pdf_root / f"{slug}.pdf"

    # --- 1) Download PDF ---
    try:
        resp = requests.get(
            url,
            stream=True,
            timeout=(10, 60),  # connect, read
        )
        resp.raise_for_status()
    except Exception as e:
        _log_debug(f"ingest_source: PDF download FAILED for {url}: {e!r}")
        raise RuntimeError(f"Failed to download PDF from {url}: {e}") from e

    try:
        with pdf_path.open("wb") as f:
            for chunk in resp.iter_content(chunk_size=8192):
                if not chunk:
                    continue
                f.write(chunk)
    except Exception as e:
        _log_debug(f"ingest_source: writing PDF FAILED {pdf_path}: {e!r}")
        raise RuntimeError(f"Failed to write PDF to {pdf_path}: {e}") from e

    _log_debug(f"ingest_source: PDF saved to {pdf_path}")

    # --- 2) Convert PDF -> TXT using pdftotext ---
    OCR_DIR.mkdir(parents=True, exist_ok=True)
    txt_path = OCR_DIR / f"{slug}.txt"

    try:
        # -layout preserves columns reasonably well
        subprocess.run(
            ["pdftotext", "-layout", str(pdf_path), str(txt_path)],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        msg = (
            "pdftotext not found on system PATH. Install poppler-utils "
            "(Debian/Ubuntu: 'sudo apt install poppler-utils')."
        )
        _log_debug(f"ingest_source: {msg}")
        raise RuntimeError(msg)
    except subprocess.CalledProcessError as e:
        _log_debug(f"ingest_source: pdftotext FAILED for {pdf_path}: {e!r}")
        raise RuntimeError(f"pdftotext failed for {pdf_path}: {e}") from e

    if not txt_path.exists():
        raise RuntimeError(f"pdftotext did not produce TXT file at {txt_path}")

    _log_debug(f"ingest_source: TXT saved to {txt_path}")

    # --- 3) Manifest entry (paths relative to DATA_DIR when possible) ---
    try:
        pdf_rel = pdf_path.relative_to(DATA_DIR)
    except ValueError:
        pdf_rel = pdf_path

    try:
        txt_rel = txt_path.relative_to(DATA_DIR)
    except ValueError:
        txt_rel = txt_path

    entry: dict[str, object | None] = {
        "kind": "web_pdf",
        "pdf": str(pdf_rel),
        "txt": str(txt_rel),
        "source_url": url,
    }
    if case:
        entry["case"] = case

    append_manifest_entry(entry)
    _log_debug(f"ingest_source: manifest entry appended for slug={slug!r}")

    # --- 4) Index TXT ---
    try:
        index_txt_document(txt_path)
    except Exception as e:
        _log_debug(f"ingest_source: index_txt_document FAILED for {txt_path}: {e!r}")
        # Don't kill the ingest on index failure; PDF+TXT+manifest already exist.

    return pdf_path, txt_path


