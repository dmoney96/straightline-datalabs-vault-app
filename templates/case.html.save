{% extends "base.html" %}

{% block title %}Case {{ case_name }} · Straightline Vault{% endblock %}

{% block header_meta %}
  Case corpus view for <code>{{ case_name }}</code>.
{% endblock %}

{% block content %}

<section class="card">
  <h2 style="margin:0 0 0.5rem 0; display:flex; align-items:center; gap:0.5rem;">
    <span>📂</span>
    <span>Case: <code>{{ case_name }}</code></span>
  </h2>

  <p class="meta-soft" style="margin:0;">
    {{ docs|length }} document{{ docs|length != 1 and "s" or "" }} in this case.
  </p>
</section>

<section class="card card--subtle">
  {% if docs and docs|length > 0 %}
    <div class="table-wrapper" style="margin-top:0.25rem;">
      <table class="table--data">
        <thead>
          <tr>
            <th style="width:22%;">Timestamp (UTC)</th>
            <th style="width:22%;">Doc ID</th>
            <th style="width:10%;">Kind</th>
            <th style="width:16%;">Domain</th>
            <th style="width:20%;">Source</th>
            <th style="width:10%;">Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for d in docs %}
            <tr>
              <td>
                {% if d.timestamp %}
                  <code>{{ d.timestamp }}</code>
                {% else %}
                  <span class="meta-soft">—</span>
                {% endif %}
              </td>

              <td class="docid-cell">
                {% if d.doc_id %}
                  <code>{{ d.doc_id }}</code>
                {% else %}
                  <span class="meta-soft">(unknown)</span>
                {% endif %}
              </td>

              <td>
                {% if d.kind %}
                  <span class="pill-badge pill-badge--kind">{{ d.kind }}</span>
                {% else %}
                  <span class="meta-soft">—</span>
                {% endif %}
              </td>

              <td>
                {% if d.domain %}
                  <code>{{ d.domain }}</code>
                {% else %}
                  <span class="meta-soft">—</span>
                {% endif %}
                {% if d.has_text is not none %}
                  <div class="meta-soft" style="margin-top:0.2rem;">
                    Text: {{ "ready" if d.has_text else "pending" }}
                  </div>
                {% endif %}
              </td>

              <td class="url-cell">
                {% if d.source_url %}
                  <a href="{{ d.source_url }}" target="_blank" rel="noopener noreferrer">
                    <code>{{ d.source_url }}</code>
                  </a>
                {% elif d.pdf %}
                  <code>{{ d.pdf }}</code>
                {% else %}
                  <span class="meta-soft">—</span>
                {% endif %}
              </td>

              <td>
                {% if d.doc_id and d.doc_id != "(unknown)" %}
                  <a href="{{ url_for('doc_view', doc_id=d.doc_id) }}">Open doc</a>
                {% else %}
                  <span class="meta-soft">—</span>
                {% endif %}

                {% if d.source_url %}
                  <div class="meta-soft" style="margin-top:0.25rem;">
                    <a href="{{ d.source_url }}" target="_blank" rel="noopener noreferrer">Open source ↗</a>
                  </div>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <p class="meta-soft" style="margin:0;">
      No documents found in this case yet.
    </p>
  {% endif %}
</section>

{% endblock %}
