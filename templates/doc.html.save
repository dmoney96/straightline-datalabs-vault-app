{% extends "base.html" %}

{% block title %}Doc {{ doc_id }} · Straightline Vault{% endblock %}

{% block header_meta %}
  Single-document view for <code>{{ doc_id }}</code>.
  {% if case_name %}
    Case: <code>{{ case_name }}</code>.
  {% endif %}
{% endblock %}

{% block content %}

<section class="card">

  <p style="margin:0 0 0.5rem 0; font-size:0.85rem; font-weight:600; color:#e5e7eb;">
    Provenance metadata
  </p>

  <div
    class="meta-soft"
    style="
      display:grid;
      grid-template-columns: 140px 1fr;
      gap:0.25rem 0.75rem;
      font-size:0.85rem;
    "
  >
    <div>Document ID</div>
    <div><code>{{ doc_id }}</code></div>

    <div>Case</div>
    <div>
      {% if case_name %}
        <code>{{ case_name }}</code>
      {% else %}
        <span class="meta-soft">—</span>
      {% endif %}
    </div>

    <div>Kind</div>
    <div>
      {% if kind %}
        <code>{{ kind }}</code>
      {% else %}
        <span class="meta-soft">—</span>
      {% endif %}
    </div>

    <div>Timestamp</div>
    <div>
      {% if timestamp %}
        <code>{{ timestamp }}</code>
      {% else %}
        <span class="meta-soft">—</span>
      {% endif %}
    </div>

    <div>Source URL</div>
    <div>
      {% if source_url %}
        <a href="{{ source_url }}" target="_blank" rel="noopener noreferrer">
          {{ source_url }}
        </a>
      {% else %}
        <span class="meta-soft">—</span>
      {% endif %}
    </div>

    <div>TXT path</div>
    <div>
      {% if txt %}
        <code>{{ txt }}</code>
      {% else %}
        <span class="meta-soft">—</span>
      {% endif %}
    </div>

      {% if html %}
        <div>
          <strong>HTML snapshot:</strong>
          <a href="{{ url_for('download_doc',doc_id=doc_id, kind='html') }}">
            

    <div>PDF path</div>
    <div>
      {% if pdf %}
        <code>{{ pdf }}</code>
      {% else %}
        <span class="meta-soft">—</span>
      {% endif %}
    </div>

    <div>Content type</div>
    <div>
      {% if metadata.content_type %}
        <code>{{ metadata.content_type }}</code>
      {% else %}
        <span class="meta-soft">—</span>
      {% endif %}
    </div>

    <div>Last modified</div>
    <div>
      {% if metadata.last_modified %}
        <code>{{ metadata.last_modified }}</code>
      {% else %}
        <span class="meta-soft">—</span>
      {% endif %}
    </div>

    <div>SHA256 TXT</div>
    <div>
      {% if metadata.sha256_txt %}
        <code>{{ metadata.sha256_txt }}</code>
      {% else %}
        <span class="meta-soft">—</span>
      {% endif %}
    </div>

    <div>SHA256 PDF</div>
    <div>
      {% if metadata.sha256_pdf %}
        <code>{{ metadata.sha256_pdf }}</code>
      {% else %}
        <span class="meta-soft">—</span>
      {% endif %}
    </div>
  </div>

  <div class="meta" style="margin-top:0.85rem;">
    {% if txt %}
       <a href="{{ url_for('download_doc', doc_id=doc_id, kind='txt') }}">Download TXT</a>
    {% endif %}

    {% if pdf %}
      <span style="margin-left:0.75rem;">
        <a href="{{ url_for('download_doc', doc_id=doc_id, kind='pdf') }}">Download PDF</a>
      </span>
    {% endif %}

    {% if source_url %}
      <span style="margin-left:0.75rem;">
        <a href="{{ source_url }}" target="_blank" rel="noopener noreferrer">Open source ↗</a>
      </span>
    {% endif %}
  </div>

  <hr
    style="
      margin:0.9rem 0;
      border:0;
      border-top:1px solid #1f2937;
    "
  >

  <h2
    style="
      margin:0;
      display:flex;
      align-items:center;
      gap:0.5rem;
    "
  >
    <span>📄</span>
    <span>Document content</span>
  </h2>

</section>

<section class="card card--subtle">

  {% if error %}
    <p class="error">
      Could not load text content for this document:
      <br>
      <code>{{ error }}</code>
    </p>

  {% elif content %}
    <pre
      style="
        white-space:pre-wrap;
        word-wrap:break-word;
        font-size:0.9rem;
        line-height:1.4;
      "
    >
{{ content }}
    </pre>

  {% else %}
    <p class="meta-soft">
      No text content available for this document.
    </p>
  {% endif %}

</section>

{% endblock %}
